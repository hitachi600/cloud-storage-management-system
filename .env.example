# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# Storage Mode Configuration: 'local' or 's3'
# Use 'local' for local development (no AWS required)
# Use 's3' when you have configured your AWS credentials below
STORAGE_TYPE=local

# Local Storage Directory (used when STORAGE_TYPE=local)
UPLOAD_FOLDER=uploads

# Database Configuration (SQLite default, can be replaced with AWS RDS PostgreSQL/MySQL)
DATABASE_URI=sqlite:///instance/cloud_storage.db

# File Upload Limits & Security
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,txt,docx,csv,xlsx,zip

# AWS S3 Configuration (Required only when STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here
